FROM golang:trixie as builder

RUN apt-get update && \
	apt-get install -y clang-18 llvm-18 libelf-dev libbpf-dev gcc-multilib
WORKDIR /app
COPY . .

ARG BPF_CLANG=clang-18
ARG BPF_CFLAGS="-O2 -g -Wall -Werror"
ENV BPF_CLANG=${BPF_CLANG}
ENV BPF_CFLAGS=${BPF_CFLAGS}

RUN go generate pkg/bpf/bpf.go

FROM scratch
COPY --from=builder /app/pkg/bpf/bpf_* /
